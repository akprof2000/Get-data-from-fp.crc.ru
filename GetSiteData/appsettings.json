{
  // ЕДИНЫЙ файл настроек всего конвейера: все четыре приложения лежат в одном
  // каталоге и читают отсюда СВОЮ секцию. Пути образуют сквозную цепочку:
  //
  //   GetSiteData → output/  →  ParseHTML → documents/  →
  //   MLTextToData → cells/ + other/  →  ParseTextHeader → OutputJson/ (единая папка)
  //
  // Любой ключ можно переопределить переменной окружения через «__», например:
  //   ParseTextHeader__Dadata__Token=…   GetSiteData__Search__PeriodEnd=12.2026

  // ── Общий корень рабочих данных ──────────────────────────────────────
  // Все относительные пути этапов собираются под этим каталогом:
  // works/output, works/documents, works/cells, works/OutputJson и т.д.
  // Абсолютный путь в настройке этапа игнорирует WorkRoot.
  "WorkRoot": "works",

  // ── Логирование (NLog) ────────────────────────────────────────────────
  // Все приложения пишут в консоль и в logs/<приложение>.log рядом с exe.
  // Файл ротируется по archiveAboveSize (20 МБ), хранится не более
  // maxArchiveFiles частей; при старте прошлые логи удаляются.
  "NLog": {
    "throwConfigExceptions": true,
    "variables": {
      // [ЧЧ:мм:сс] [УРОВЕНЬ] сообщение — уровень опускается для Info,
      // чтобы не зашумлять массовый построчный вывод.
      "line": "[${date:format=HH\\:mm\\:ss}]${when:when=level>LogLevel.Info:inner= [${uppercase:${level}}]} ${message}${onexception:${newline}${exception:format=tostring}}"
    },
    "targets": {
      "console": {
        "type": "ColoredConsole",
        "layout": "${line}",
        "rowHighlightingRules": [
          { "condition": "level == LogLevel.Warn", "foregroundColor": "Yellow" },
          { "condition": "level == LogLevel.Error", "foregroundColor": "Red" },
          { "condition": "contains(message, '[SKIP]')", "foregroundColor": "DarkGray" }
        ]
      },
      "file": {
        "type": "AsyncWrapper",
        "overflowAction": "Block",
        "target": {
          "type": "File",
          "fileName": "${basedir}/logs/${processname}.log",
          "layout": "${line}",
          "archiveAboveSize": 20971520,
          "maxArchiveFiles": 10,
          "deleteOldFileOnStartup": true
        }
      }
    },
    "rules": {
      "0": { "logger": "*", "minLevel": "Info", "writeTo": "console,file" }
    }
  },

  // ── Этап 1: сбор страниц с fp.crc.ru ──────────────────────────────────
  "GetSiteData": {
    "Search": {
      // Термины поиска. Список построен замерами по реестру (март 2025 +
      // объёмы по всей истории): даёт +13,6 % документов к прежним пяти
      // «базов»-терминам, ~92 % новинок — настоящие БС, остальное отсеет
      // ML-классификатор. Поиск сайта понимает wildcard «*» (все словоформы
      // одним термином) и различает кириллицу/латиницу — поэтому аббревиатуры
      // и бренды продублированы в обоих алфавитах (МТС/МТC/MTC, BTS/BТS/ВТС,
      // Скартел*/Cкартел*, К-телеком*/K-телеком*): такие опечатки реально
      // встречаются в реестре, и документы с ними находятся только так.
      "Terms": [
        // Словоформы и опечатки реестра, не покрываемые масками-подстроками.
        "базов*", "базав*", "базв*", "сотов*",
        // Операторы (кириллица/латиница и перепутанные алфавиты).
        "МТС", "МТC", "MTC", "MTS",
        "МегаФон", "Вымпел*", "Мобайл", "Теле2", "Tele2*", "Билайн",
        "Ростелеком*", "К-телеком*", "K-телеком*",
        "Скартел*", "Cкартел*", "ЕКАТЕРИНБУРГ*",
        "BТS",
        // Маски-«подстроки» (звёздочка с обеих сторон): технологии, оборудование
        // и конструктивы — ловят документы без слов «базовая/сотовая». Поглощают
        // прежние термины радиотелефон*/GSM*/LTE*/ПРТО/РЭС/BTS.
        "*LTE*", "*GSM*", "*DCS*", "*NMT*", "*UMTS*", "*WCDMA*", "*NR*", "*5G*",
        "*GMSK*", "*QAM*", "*QPSK*", "*толб*", "*нтен*", "*РЭС*", "*опора*", "*ОДН*", "*БС*", "*BTS*",
        "*адио*", "*ПРТО*", "*ашня*", "*ПБК*", "*dBi*", "*дБи*", "*Вт*", "*ЭМП*", "*рубост*",
        "*отовой*", "*МГц*", "*RRU*"
      ],
      // Период сбора в формате ММ.ГГГГ (включительно).
      // Одинаковые значения — собираем один месяц.
      "PeriodStart": "01.2024",
      "PeriodEnd": "07.2026"
    },
    "OutputPath": "output",
    "Processing": {
      "ResultsPerPage": 50,
      // Одновременных запросов страниц внутри пары «термин × месяц» (страницы
      // после первой сервер отдаёт из кэша быстро).
      "Parallelism": 6,
      // Одновременных пар «термин × месяц»: первый запрос пары «холодный»
      // (30–50 с на стороне сервера), перекрытие двух пар прячет эту задержку;
      // от 6–8 одновременных холодных запросов сервер деградирует.
      "TermParallelism": 2,
      "MaxAttempts": 5,
      // 120: «холодный» первый запрос тяжёлого термина («сотов*») сервер строит
      // дольше минуты — с таймаутом 60 он не проходил ни с какой попытки.
      "RequestTimeoutSeconds": 120
    }
  },

  // ── Этап 2: HTML → тексты документов ──────────────────────────────────
  "ParseHTML": {
    "InputPath": "output",
    "DocumentsPath": "documents"
  },

  // ── Этап 3: ML-классификация «базовая станция / прочее» ───────────────
  "MLTextToData": {
    "InputRoot": "documents",
    "CellsOutputRoot": "cells",
    "NonCellsOutputRoot": "other",
    "DatabasePath": "data/state.db",
    "ModelPath": "data/model.zip",
    "ParallelDegree": 8,
    "PredictionThreshold": 0.6
  },

  // ── Этап 4: извлечение данных в JSON ─────────────────────────────────
  "ParseTextHeader": {
    // Вход — только документы о базовых станциях (выход классификатора).
    "InputBasePath": "cells",
    "OutputJsonPath": "OutputJson",
    "OutputErrorsPath": "OutputErrors",
    "Processing": {
      "LinesToRead": 12,
      // true — заново разобрать файлы из legacy-папки OutputErrors старых прогонов
      // (с v2.7.0 выход единый — OutputJson с полем missingFields у неполных записей).
      "ReprocessErrors": false
    },
    // Нормализация адресов через Dadata. Ключи задавайте здесь, переменными
    // окружения (ParseTextHeader__Dadata__Token) или через user-secrets.
    "Dadata": {
      "Enabled": false,
      "Token": "",
      "Secret": ""
    }
  },

  // Нормализация адресов по офлайн-базе ГАР. GarSource — путь к gar_xml.zip
  // или прямой URL выгрузки (по URL скачиваются только нужные файлы).
  "NormalizeAddress": {
    "GarSource": "https://fias-file.nalog.ru/downloads/2026.08.14/gar_xml.zip",
    // База ГАР — долгоживущий справочник: по умолчанию data/gar.sqlite рядом с
    // приложением (как модель классификатора), чистка works её не затрагивает.
    // Ключ DbPath задаётся только чтобы переопределить (относительный — под WorkRoot).
    // true — режим «до дома»: импортируются и дома (полная адресная книга,
    // +40 млн записей, скачивание ~30 ГБ вместо ~3, база — гигабайты), И ТОЛЬКО
    // в этом режиме заполняются координаты address.lat/lon (по OSM-геоданным,
    // см. OsmSource и команду import-osm). false — облегчённая база без домов,
    // координаты адресов не заполняются вовсе.
    "IncludeHouses": false,
    // OSM-выгрузка для геокодера (*.osm.pbf): URL или локальный файл. Полная
    // Россия ~4 ГБ; для проверки годится региональный срез с Geofabrik.
    "OsmSource": "https://download.geofabrik.de/russia-latest.osm.pbf",
    // Автообновление OSM-геоданных командой update: старше стольких дней — переимпорт.
    "OsmMaxAgeDays": 90,
    // Удалять локальный архив выгрузки после успешного импорта в базу
    // (false — если файл ещё пригодится, напр. для включения домов).
    "DeleteSourceAfterImport": true,
    // Обогащение: JSON из InputJsonPath + объект «address» → OutputNormalizedPath.
    "InputJsonPath": "OutputJson",
    "OutputNormalizedPath": "OutputNormalized"
  },

  // Скачивание выгрузки ГАР (Госадресный реестр) с автообновлением по версии.
  // Запускается на машине с интернетом; архив переносится в закрытый контур.
  "GetGarData": {
    // Каталог для архивов gar_xml_<версия>.zip и version.json (относительный — под WorkRoot).
    "OutputPath": "gar",
    // true — качать дельту (gar_delta_xml.zip) вместо полной выгрузки.
    "Delta": false,
    "MaxAttempts": 5
  }
}
